# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>    # Solo servidor. NUNCA exponer al cliente.

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=Academia WARA GPS <notificaciones@tudominio.com>

# ── Google Drive (opcional) ───────────────────────────────────────────────────
# Habilita el escaneo de carpetas en el importador masivo de contenidos.
# Ver SETUP.md § "API key de Google Drive". Solo servidor.
GOOGLE_DRIVE_API_KEY=AIza<key>

# ── Odoo (opcional) ───────────────────────────────────────────────────────────
# Habilita la aprobación automática de registros cuyo email figura en los
# contactos de Odoo. Ver SETUP.md § 9. Solo servidor.
ODOO_URL=https://<empresa>.odoo.com
ODOO_DB=<nombre-de-la-base>
ODOO_LOGIN=<email-del-usuario-odoo>
ODOO_API_KEY=<api-key>

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://wara-academia.vercel.app
